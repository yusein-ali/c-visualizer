{
  "version": 1,
  "about": "printf parity: each case is a format, typed arguments and the text C (glibc, LP64) prints. test/stdio-parity.test.ts runs every case through formatPrintf, through the built c-stdio.js, and - unless engine is false - through the interpreter's own printf. diagnostics lists the rules formatPrintf reports. The deploy copies this file to c-stdio.parity.json.",
  "cases": [
    {
      "format": "%d",
      "args": [
        {
          "kind": "int",
          "value": 42
        }
      ],
      "expected": "42"
    },
    {
      "format": "%i",
      "args": [
        {
          "kind": "int",
          "value": -42
        }
      ],
      "expected": "-42"
    },
    {
      "format": "%5d|",
      "args": [
        {
          "kind": "int",
          "value": 42
        }
      ],
      "expected": "   42|"
    },
    {
      "format": "%-5d|",
      "args": [
        {
          "kind": "int",
          "value": 42
        }
      ],
      "expected": "42   |"
    },
    {
      "format": "%05d",
      "args": [
        {
          "kind": "int",
          "value": -42
        }
      ],
      "expected": "-0042"
    },
    {
