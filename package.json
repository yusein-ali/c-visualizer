{
  "name": "c-visualizer",
  "version": "1.0.0",
  "description": "Browser-only C program visualizer and step debugger",
  "main": "index.js",
  "author": "Yusein R. Ali",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "start": "cross-env NODE_ENV=dev webpack serve --config webpack.config.dev.js",
    "build": "npm run clean && cross-env NODE_ENV=prod webpack --config webpack.config.js && npm run license",
    "license": "node scripts/generate-licenses.js",
    "deploy": "npm run clean:embed && cross-env NODE_ENV=prod webpack --config webpack.config.deploy.js && npm run license:embed",
    "deploy:debug": "npm run clean:embed && cross-env NODE_ENV=prod DEBUG_DEPLOY=1 webpack --config webpack.config.deploy.js && npm run license:embed",
    "debug:host-integration": "npm run deploy:debug && node scripts/serve-host-integration.js",
    "clean:embed": "shx rm -rf dist/embed",
    "license:embed": "cross-env LICENSE_OUT=dist/embed/licenses.html node scripts/generate-licenses.js",
    "test": "jest",
    "clean": "shx rm -rf dist",
    "analyze": "cross-env NODE_ENV=prod ANALYZE=1 webpack --config webpack.config.dev.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.prod.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Edge versions",
    "last 2 Safari versions",
    "Firefox ESR",
    "not dead"
  ],
  "devDependencies": {
    "@babel/cli": "7.28.3",
    "@babel/core": "7.29.7",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "7.20.7",
    "@babel/plugin-syntax-dynamic-import": "7.8.3",
    "@babel/plugin-transform-runtime": "7.28.5",
    "@babel/plugin-transform-typescript": "7.28.5",
    "@babel/preset-env": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@babel/runtime": "7.28.4",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.1",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.7",
    "@lezer/highlight": "1.2.3",
    "@eslint/js": "9.39.1",
    "@joint/core": "4.3.1",
    "@types/jest": "29.5.14",
    "@types/string-hash": "1.1.3",
    "assert": "2.1.0",
    "babel-loader": "10.1.1",
    "buffer": "6.0.3",
    "core-js": "3.8.0",
    "cross-env": "7.0.3",
    "css-loader": "7.1.4",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "globals": "17.11.0",
    "hashids": "2.2.2",
    "html-webpack-plugin": "5.6.8",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "license-checker-rseidelsohn": "5.0.1",
    "lint-staged": "10.5.4",
    "prettier": "3.6.2",
    "process": "0.11.10",
    "shx": "0.3.4",
    "string-hash": "1.1.3",
    "style-loader": "4.0.0",
    "ts-jest": "29.4.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.47.0",
    "unicoen.ts": "0.5.0",
    "util": "0.12.5",
    "vector2d": "3.0.0",
    "webpack": "5.109.2",
    "webpack-bundle-analyzer": "4.10.2",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "6.0.0",
    "webpack-merge": "6.0.1"
  }
}
