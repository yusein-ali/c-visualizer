  "scripts": {
    "start": "cross-env NODE_ENV=dev webpack serve --config webpack.config.dev.js",
    "build": "npm run clean && cross-env NODE_ENV=prod webpack --config webpack.config.js && npm run license",
    "license": "node scripts/generate-licenses.js",
    "test": "jest",
    "clean": "shx rm -rf dist",
    "analyze": "cross-env NODE_ENV=prod ANALYZE=1 webpack --config webpack.config.dev.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.prod.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ]
